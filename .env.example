# GitHub.com API URL; for GitHub Enterprise Server use https://github.example.com/api/v3
GITHUB_API_URL=https://api.github.com

# GitHub fine-grained PAT with read access to the repositories you want to observe.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Comma-separated owner/repository values.
GITHUB_REPOSITORIES=your-org/identity-service,your-org/billing-service,your-org/customer-service

# Poll every 10 seconds by default.
GITHUB_POLLING_INTERVAL_MS=10000
GITHUB_INITIAL_EVENTS=30
