# GitHub.com API URL; for GitHub Enterprise Server use https://github.example.com/api/v3
GITHUB_API_URL=https://api.github.com

# GitHub fine-grained PAT with read access to the repositories you want to observe.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Comma-separated owner/repository values.
GITHUB_REPOSITORIES="sky-uk/sky-id-external-ui-service,sky-uk/sky-id-notification-service"

# Poll every 3 minutes by default.
GITHUB_POLLING_INTERVAL_MS=180000

# How many pull requests to inspect per repository for each open/closed poll.
GITHUB_PULL_REQUESTS_PER_REPOSITORY=30

# Mark open pull requests older than this many days as waiting too long.
BLACKBOX_STALE_PR_DAYS=3

